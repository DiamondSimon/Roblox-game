        <Item class="ModuleScript" referent="RBX11">
          <Properties>
            <string name="Name">QuestConfig</string>
            <ProtectedString name="Source">return {
 Version=1,
 Daily={
  {Id="collect",Name="Haul 5 machines home",Event="Collected",Target=5,Cores=10},
  {Id="rare",Name="Deliver 2 Rare+ machines",Event="RareCollected",Target=2,Cores=12},
  {Id="upgrades",Name="Purchase 2 upgrades",Event="Upgrade",Target=2,Cores=8},
