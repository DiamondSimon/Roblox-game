   table.insert(updaters,function() local current=state.Milestones[i];description.Text=math.min(current.Progress,current.Count).." / "..current.Count.." discovered • "..current.Cores.." Cores";claim.Text=current.Claimed and "CLAIMED" or current.Progress&gt;=current.Count and "CLAIM REWARD" or "KEEP COLLECTING";fill.Size=UDim2.fromScale(math.min(1,current.Progress/current.Count),1) end)
