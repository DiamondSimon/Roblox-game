   table.insert(updaters,function() b.Text=not Machines.canCollect(id,state.Rebirths) and ("LOCKED • "..m.RequiredRebirths.." REBIRTHS") or state.Discovered[id] and "DISCOVERED" or "UNDISCOVERED" end)
