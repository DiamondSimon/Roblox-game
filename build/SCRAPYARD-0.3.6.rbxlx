        <Item class="ModuleScript" referent="RBX22">
          <Properties>
            <string name="Name">RewardsConfig</string>
            <ProtectedString name="Source">return {
 Codes={FOUNDRY={Cores=20},SCRAP032={Cores=15}},
 Milestones={{Id="discover5",Count=5,Cores=10},{Id="discover15",Count=15,Cores=25},{Id="discover30",Count=30,Cores=50}},
 RushPeriod=600,RushDuration=120,RushMultiplier=1.25,
}
